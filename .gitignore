# The add-on's shipped JARs ARE part of the pack — tests/test_survival_rush_deploy_contract.py
# asserts survivalrushbridge-1.0.0.jar and tiktokbridge-1.0.0.jar exist. Only the local
# rollback copies are excluded.
addons/*/mods/*.jar.bak*
addons/*/mods/*.jar.pre-*

# ---------------------------------------------------------------------------
# Personal add-ons — NOT part of the shared repository.
# Survival Rush (and any sibling pack) is developed locally here but is never
# tracked or published: it is a personal project with its own distribution.
# app.py imports it opportunistically (see _SURVIVAL_RUSH_AVAILABLE), so a
# checkout without this directory still boots normally.
# ---------------------------------------------------------------------------
addons/
objective_rush_headless.py
tests/test_objective_rush_headless.py
